# ==========================================
# WhatsApp AI Agent - Environment Template
# ==========================================
# Copy this file to .env and fill in real values.
# DO NOT commit .env to version control.

# ==================== APPLICATION ====================
APP_NAME=WhatsApp AI Agent
APP_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
BASE_URL=http://localhost:8000
TIMEZONE=Asia/Kolkata

# ==================== POSTGRES ====================
POSTGRES_USER=calendaruser
POSTGRES_PASSWORD=change_me_secure_password
POSTGRES_DB=calendar_agent
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ==================== REDIS ====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password
REDIS_DB=0

# ==================== HERMES AGENT ====================
HERMES_BASE_URL=http://hermes:8642
HERMES_API_KEY=hermes_api_key_change_me

# ==================== LITELLM PROXY ====================
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MASTER_KEY=litellm_master_key_change_me

# ==================== OPENWA (WhatsApp Layer) ====================
# OpenWA replaces the old Meta Cloud API. It runs as a Docker service.
OPENWA_BASE_URL=http://openwa:8080
OPENWA_API_KEY=openwa_master_key_change_me
OPENWA_SESSION_ID=my-session
OPENWA_WEBHOOK_SECRET=change_me_random_hmac_secret
OPENWA_WEBHOOK_URL=http://backend:8000/webhook/openwa

# Owner's WhatsApp number (digits only, no +, no spaces). YOUR phone.
# Permission requests and proactive notifications go here.
OWNER_WA_PHONE=919999999999

# ==================== LLM PROVIDER ====================
# Provider options: github | google | anthropic | ollama
LLM_PROVIDER=github
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3

# GitHub Models (free) - https://github.com/marketplace/models
GITHUB_TOKEN=

# Google AI Studio (free 1M tokens/day)
GOOGLE_AI_API_KEY=

# Groq (free tier, very fast)
GROQ_API_KEY=

# OpenRouter (paid, model flexibility)
OPENROUTER_API_KEY=

# Nvidia NIM (free credits)
NVIDIA_NIM_API_KEY=

# Anthropic Claude (paid)
ANTHROPIC_API_KEY=

# Ollama (local, free)
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=mistral:7b-instruct

# ==================== GOOGLE CALENDAR ====================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/callback
GOOGLE_SERVICE_ACCOUNT_FILE=/app/google-service-account.json

# Encryption key for OAuth tokens at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ==================== AGENT BEHAVIOR ====================
AGENT_MAX_ITERATIONS=5
AGENT_TIMEOUT_SECONDS=30
CONVERSATION_MAX_MESSAGES=50
CONVERSATION_TTL_SECONDS=86400

# Rate limiting per WhatsApp sender
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# ==================== PERMISSION FLOW ====================
# When the agent should ask the owner before acting.
PERMISSION_REQUIRED_FOR_CREATE=false
PERMISSION_REQUIRED_FOR_DELETE=true
PERMISSION_REQUIRED_FOR_GROUP_REPLY=true
PERMISSION_TIMEOUT_MINUTES=15

# ==================== PROACTIVE FEATURES ====================
REMINDER_15MIN_ENABLED=true
REMINDER_1HOUR_ENABLED=true
REMINDER_1DAY_ENABLED=true
MORNING_BRIEFING_TIME=08:00
EVENING_SUMMARY_TIME=20:00
CONFLICT_CHECK_INTERVAL_MINUTES=30
WEEKLY_INSIGHTS_DAY=monday
WEEKLY_INSIGHTS_TIME=09:00
PROACTIVE_NUDGES_ENABLED=true

# ==================== HTTP/TIMEOUTS ====================
HTTP_CONNECT_TIMEOUT=10.0
HTTP_READ_TIMEOUT=30.0
HTTP_WRITE_TIMEOUT=30.0
HTTP_POOL_TIMEOUT=10.0

# ==================== RETRY ====================
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=10.0

# ==================== COMPOSE SYNC KEYS ====================
API_SERVER_KEY=hermes_api_key_change_me
OPENAI_API_KEY=litellm_master_key_change_me
AUTHENTICATION_API_KEY=openwa_master_key_change_me

