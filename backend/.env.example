# ==================== APP ====================
APP_NAME=omniWA
APP_VERSION=3.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
BASE_URL=http://localhost:8000
TIMEZONE=Asia/Kolkata

# ==================== POSTGRES ====================
POSTGRES_USER=calendaruser
POSTGRES_PASSWORD=change_me_secure_password
POSTGRES_DB=calendar_agent
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ==================== REDIS ====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password
REDIS_DB=0

# ==================== WHATSAPP IDENTITY ====================
# Owner phone (E.164 digits, no +). Used for ACL/OAuth owner detection.
OWNER_WA_PHONE=919999999999
BOT_RELATIONSHIP_MODE=self_chat

# ---- WhatsApp bridge bootstrap (read by the hermes container) ----
# Runtime changes are made from the dashboard (Identity tab / /api/pairing/bridge)
# and stored on the shared hermes_data volume; these seed the first boot only.
WHATSAPP_MODE=self-chat                # self-chat | bot
WHATSAPP_DM_POLICY=allowlist           # allowlist | open | disabled
WHATSAPP_GROUP_POLICY=allowlist        # allowlist | open | disabled
WHATSAPP_REQUIRE_MENTION=true          # groups need @mention
WHATSAPP_ALLOWED_USERS=919999999999    # comma-separated numbers/JIDs/LIDs

# ==================== HERMES AGENT ====================
HERMES_BASE_URL=http://hermes:8642
HERMES_API_KEY=hermes_api_key_change_me
HERMES_OWNS_WHATSAPP=true              # v3: bridge delivers replies itself
HERMES_DATA_DIR=/opt/hermes_data       # shared volume mount inside backend

# ==================== GOOGLE WORKSPACE OAUTH ====================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/callback
GOOGLE_SERVICE_ACCOUNT_FILE=/app/google-service-account.json

# ==================== SECURITY ====================
TOKEN_ENCRYPTION_KEY=                  # Fernet key — encrypts Google tokens at rest
ADMIN_PASSWORD=change_me_admin_password
SESSION_SECRET_KEY=change_me_super_secret_session_key

# ==================== LEGACY / OPTIONAL ====================
# Provider keys below are leftovers from the v2 LiteLLM era and unused by the
# v3 stack (Hermes routes its own models). Safe to leave empty.
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_NIM_API_KEY=
GOOGLE_AI_API_KEY=
ANTHROPIC_API_KEY=
GITHUB_TOKEN=

# Voice preferences (STT/TTS pipeline dormant since the webhook relay removal)
STT_PROVIDER=groq
TTS_PROVIDER=edge
TTS_VOICE_CLOUD=en-US-AvaNeural
