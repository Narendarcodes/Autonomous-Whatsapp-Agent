# ============================================================
# omniWA backend/.env — mirrors app/core/config.py Settings
# Copy to backend/.env and fill in real values.
# NEVER commit the filled file.
# ============================================================

# ---------- APP ----------
ENVIRONMENT=development              # production triggers fail-fast secret validation (#3)
DEBUG=false
LOG_LEVEL=INFO
BASE_URL=https://api.narendar.tech   # public URL used for OAuth callbacks / links
TIMEZONE=Asia/Kolkata

# ---------- SECURITY (all REQUIRED in production; defaults are refused) ----------
# Dashboard login password
ADMIN_PASSWORD=change_me_generate_one
# Session cookie signing/secret — python -c "import secrets;print(secrets.token_hex(32))"
SESSION_SECRET_KEY=change_me_generate_one
# Fernet key for OAuth token encryption — python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# HMAC secret Evolution/Hermes must send in X-Evolution-Signature — python -c "import secrets;print(secrets.token_hex(32))"
OPENWA_WEBHOOK_SECRET=

# ---------- POSTGRES ----------
POSTGRES_USER=calendaruser
POSTGRES_PASSWORD=calendarpass
POSTGRES_DB=calendar_agent
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---------- REDIS ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redispass
REDIS_DB=0

# ---------- OWNER ----------
OWNER_WA_PHONE=919876543210          # bare number, no '+'

# ---------- HERMES AGENT ----------
HERMES_BASE_URL=http://hermes:8642
HERMES_API_KEY=generate_one_if_hermes_requires_auth
HERMES_OWNS_WHATSAPP=false           # v3: bridge delivers replies itself
HERMES_DATA_DIR=/opt/hermes_data
HERMES_HEALTH_URL=http://hermes:8642

# ---------- LITELLM ROUTER ----------
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MASTER_KEY=generate_one

# Additional provider keys (LiteLLM fallback chain uses whichever are set)
GITHUB_TOKEN=
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_NIM_API_KEY=
GOOGLE_AI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- EVOLUTION API (openwa container; optional in lean deploys) ----------
OPENWA_BASE_URL=http://openwa:8080
OPENWA_API_KEY=
OPENWA_SESSION_ID=my-session
OPENWA_WEBHOOK_URL=http://backend:8000/webhook/openwa
# OPENWA_WEBHOOK_SECRET shared with section above

# ---------- GOOGLE OAUTH ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.narendar.tech/oauth/callback
GOOGLE_SERVICE_ACCOUNT_FILE=/app/google-service-account.json

# ---------- VOICE ----------
STT_PROVIDER=groq                    # groq | local (faster-whisper container)
TTS_PROVIDER=edge                    # edge | local (kokoro container)
LOCAL_STT_URL=http://whisper-api:8000/v1
LOCAL_TTS_URL=http://kokoro-api:8000/v1

# ---------- INGEST / MODES ----------
CONTACT_INGEST_TOKEN=                # Hermes -> backend contacts push (empty = disabled)
BOT_RELATIONSHIP_MODE=self_chat      # self_chat | dual_number

# ---------- LIMITS ----------
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
PREFERENCE_PROMOTION_THRESHOLD=5   # confirmations before proposing preference automation

# ---------- APP META ----------
APP_NAME=omniWA
APP_VERSION=2.0.0

# ---------- LLM ----------
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=mistral:7b-instruct
TTS_VOICE_CLOUD=en-US-AvaNeural
TTS_VOICE_LOCAL=af_bella

# ---------- AGENT / CONVERSATION ----------
AGENT_MAX_ITERATIONS=5
AGENT_TIMEOUT_SECONDS=30
CONVERSATION_MAX_MESSAGES=50
CONVERSATION_TTL_SECONDS=86400

# ---------- PERMISSION FLOW ----------
PERMISSION_REQUIRED_FOR_CREATE=false
PERMISSION_REQUIRED_FOR_DELETE=true
PERMISSION_REQUIRED_FOR_GROUP_REPLY=true
PERMISSION_TIMEOUT_MINUTES=15

# ---------- PROACTIVE ----------
REMINDER_15MIN_ENABLED=true
REMINDER_1HOUR_ENABLED=true
REMINDER_1DAY_ENABLED=true
MORNING_BRIEFING_TIME=08:00
EVENING_SUMMARY_TIME=20:00
CONFLICT_CHECK_INTERVAL_MINUTES=30
WEEKLY_INSIGHTS_DAY=monday
WEEKLY_INSIGHTS_TIME=09:00
PROACTIVE_NUDGES_ENABLED=true

# ---------- HTTP ----------
HTTP_CONNECT_TIMEOUT=10.0
HTTP_READ_TIMEOUT=30.0
HTTP_WRITE_TIMEOUT=30.0
HTTP_POOL_TIMEOUT=10.0

# ---------- RETRY ----------
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=10.0
