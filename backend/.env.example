# ==========================================
# WHATSAPP AI CALENDAR AGENT - ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env file to version control!

# ==================== APP SETTINGS ====================
DEBUG=True
ENVIRONMENT=development
LOG_LEVEL=INFO
# Base URL for the API (used for OAuth callbacks and links sent to users)
# Change this to your ngrok/production URL when deploying
BASE_URL=http://localhost:8000

# ==================== DATABASE SETTINGS ====================
POSTGRES_USER=calendaruser
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=calendar_agent
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ==================== REDIS SETTINGS ====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ==================== OLLAMA SETTINGS ====================
# Ollama runs on host machine, Docker accesses via host.docker.internal
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=mistral:7b-instruct-v0.3-q4_K_M
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.7

# ==================== WHATSAPP CLOUD API ====================
# Get these from: https://developers.facebook.com/apps
WHATSAPP_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token_here
WHATSAPP_API_VERSION=v21.0

# ==================== GOOGLE OAUTH & CALENDAR ====================
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/callback

# ==================== SESSION & CACHE SETTINGS ====================
SESSION_TTL=3600
CONVERSATION_MAX_MESSAGES=10
CONVERSATION_TTL=3600

# ==================== RATE LIMITING ====================
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60

# ==================== AGENT SETTINGS ====================
AGENT_MAX_ITERATIONS=5
AGENT_TIMEOUT=30
