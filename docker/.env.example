# docker compose reads THIS file (docker/.env) for ${VAR} substitution in
# docker-compose.yml. backend/.env is only passed into containers.
# These four MUST match backend/.env, or Postgres/Redis start with the
# compose defaults and the backend fails auth at startup
# ("invalid username-password pair").
POSTGRES_USER=calendaruser
POSTGRES_PASSWORD=change_me_secure_password
POSTGRES_DB=calendar_agent
REDIS_PASSWORD=change_me_redis_password
# Optional: TUNNEL_TOKEN=eyJ...  (docker compose --profile public up -d)
