# ==================== LLM CONFIGURATION ====================
# Choose which LLM service to use (true = GitHub Models, false = Ollama)
USE_GITHUB_MODELS=true

# GitHub Models Settings (Recommended for Production)
# Get your token from: https://github.com/settings/tokens
# Request model access: https://github.com/marketplace/models
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_MODEL=gpt-4o-mini

# Ollama Settings (Fallback/Local Development)
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=mistral:7b-instruct-v0.3-q4_K_M

# ==================== APP SETTINGS ====================
# Base URL for the API (used for OAuth callbacks and links sent to users)
# Change this to your ngrok/production URL when deploying
BASE_URL=http://localhost:8000

# ==================== WHATSAPP CONFIGURATION ====================
WHATSAPP_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token
WHATSAPP_APP_SECRET=your_app_secret

# ==================== GOOGLE OAUTH CONFIGURATION ====================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/callback

# ==================== DATABASE CONFIGURATION ====================
POSTGRES_USER=calendaruser
POSTGRES_PASSWORD=calendarpass
POSTGRES_DB=calendar_agent
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ==================== REDIS CONFIGURATION ====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redispass
REDIS_DB=0

# ==================== APPLICATION CONFIGURATION ====================
DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=INFO
